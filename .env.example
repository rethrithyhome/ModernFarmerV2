# ការតភ្ជាប់ Database
DATABASE_URL=postgres://postgres:password@localhost:5432/modern_farmer

# សុវត្ថិភាព — ត្រូវប្តូរជាតម្លៃសម្ងាត់ផ្ទាល់ខ្លួន មុនដាក់ដំណើរការពិត
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

PORT=3000
NODE_ENV=development

# គណនី admin ដំបូង (ប្រើពេល seed)
SEED_ADMIN_EMAIL=admin@modernfarmer.kh
SEED_ADMIN_PASSWORD=ChangeMe123!

# ក្នុងការប្រើពិត — កំណត់ជាដូមេនរបស់អ្នក (បំបែកដោយក្បៀស បើមានច្រើន)
# CORS_ORIGIN=https://app.modernfarmer.com
