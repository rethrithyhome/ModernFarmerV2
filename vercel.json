{
  "buildCommand": "cd web && npm install && npm run build",
  "outputDirectory": "web/dist",
  "regions": ["sin1"],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" }
  ],
  "crons": [
    {
      "path": "/api/admin/purge-idempotency",
      "schedule": "0 20 * * *"
    }
  ]
}
